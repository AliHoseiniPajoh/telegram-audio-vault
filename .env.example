# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Numerical Telegram User ID of the single allowed owner (obtain from @userinfobot)
ALLOWED_USER_ID=987654321

# Web Server Port
PORT=3000

# Public HTTPS URL of this server where Telegram can load the Mini App
# (e.g. https://your-domain.com or https://xxxx.ngrok-free.app)
WEBAPP_URL=https://your-domain.com

# Environment mode
NODE_ENV=development
